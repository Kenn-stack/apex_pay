        "merchant_tier": "Enterprise",
        "contact_email": "dev@merchant.com",
        "timestamp": "2026-09-25T12:00:00Z",
        "issue_description": "Valid issue description that passes the minimum character limit."
      }
    },
    {
      "test_name": "pydantic_fail_invalid_enum_and_email",
      "expected_result": "FAIL",
      "target_field": ["merchant_tier", "contact_email"],
      "expected_error": "Invalid enum value for merchant_tier and malformed RFC-5322 email string",
      "payload": {
        "ticket_id": "TCK-55201",
        "merchant_id": "mer_tier_test",
        "merchant_tier": "CustomVIP",
        "contact_email": "support_team@invalid-domain",
        "timestamp": "2026-09-25T12:00:00Z",
        "issue_description": "Valid issue description reporting recurring 502 Bad Gateway responses."
      }
    },
    {
      "test_name": "pydantic_fail_invalid_timestamp_and_min_length",
      "expected_result": "FAIL",
      "target_field": ["timestamp", "issue_description"],
      "expected_error": "Non-datetime timestamp string and issue_description length under 15 characters",
      "payload": {
        "ticket_id": "TCK-771234",
        "merchant_id": "mer_retail_12",
        "merchant_tier": "Starter",
        "contact_email": "contact@shop.com",
        "timestamp": "Yesterday at 4pm",
        "issue_description": "API is down"
      }
    }
